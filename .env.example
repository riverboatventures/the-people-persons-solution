# Port for the local Jarvis API server (system stats, and later agents/voice).
JARVIS_API_PORT=4317

# Shown in the top-right operator badge and used in Jarvis' greetings.
VITE_OPERATOR_NAME=Commander

# Optional: bottom-bar location label and live weather (Open-Meteo, no API key).
# VITE_LOCATION_NAME=Austin, TX
# VITE_WEATHER_LAT=30.27
# VITE_WEATHER_LON=-97.74
# VITE_WEATHER_UNIT=fahrenheit
